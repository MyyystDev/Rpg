    "authors": ["${mod_author}"],
    "license": "${license}",
    "environment": "*",
    "entrypoints": {
        "main": ["com.myyyst.myrpg.entities.MyrpgEntitiesFabric"],
        "client": ["com.myyyst.myrpg.entities.MyrpgEntitiesFabricClient"]
